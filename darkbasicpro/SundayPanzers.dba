      set object n+300,1,0,1,0,0,0,0
      ghost object on 300+n
      hit(n)=0
      hide object n+300:position object n+300,0,-5000,0
      endcase

      case 6
      clone object n,65200+t
      texture object n,100+c
      scale object n,100,99,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.75:rem steering value
      tk#(n,8)=2.7:rem max speed value
      tk#(n,16)=3:hide limb n,3:rem limb to fire tank
      tk#(n,19)=145:rem reload time
      tk#(n,20)=110:rem bullet counter
      tk#(n,21)=15:rem power of bullet
      tk#(n,33)=22:rem range collision (1/2 tank dimension)
      tk#(n,36)=-0.15:rem initial degree shot
      tk#(n,37)=105:tk#(n,49)=tk#(n,37):rem energy
      tk#(n,39)=1.35:rem k magnifier for bullet shot himpact
      tk#(n,40)=7000:rem k start sound engine
      tk#(n,41)=20:rem range collision height tank (1/2 tank height)
      tk#(n,42)=0.033:rem gravity
      tk#(n,43)=1:rem 1 can fire, 0 can't fire
      tk#(n,46)=310:rem time of turbo
      tk#(n,47)=1100:rem reload turbo time
      rem loading bullet (bullet is 100+n object)
