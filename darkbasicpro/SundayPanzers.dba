      tk#(n,37)=90:tk#(n,49)=tk#(n,37):rem energy
      tk#(n,39)=1:rem k magnifier for bullet shot himpact
      tk#(n,40)=10000:rem k start sound engine
      tk#(n,41)=20:rem range collision height tank (1/2 tank height)
      tk#(n,42)=0.033:rem gravity
      tk#(n,43)=1:rem 1 can fire, 0 can't fire
      tk#(n,46)=450:rem time of turbo
