      tk#(n,40)=14500:rem k start sound engine
      tk#(n,41)=19.5:rem range collision height tank (1/2 tank height)
      tk#(n,42)=0.030:rem gravity
      tk#(n,43)=1:rem 1 can fire, 0 can't fire
      tk#(n,46)=300:rem time of turbo
