      set object specular n+100,0
      set object n+100,1,0,0,0,0,0,0
      hide object n+100:position object n+100,0,-5000,0
      rem make shadow (shadow is 200+n object)
      clone object n+200,65212
      scale object n+200,145,145,145
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      rem loading hitball (hitball is 300+n object)
      clone object n+300,65213
      set object specular n+300,0
      set object n+300,1,0,1,0,0,0,0
      ghost object on 300+n
      hit(n)=0
      hide object n+300:position object n+300,0,-5000,0
      endcase

      case 7
      clone object n,65200+t
      texture object n,100+c
      scale object n,100,101,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.8:rem steering value
      tk#(n,8)=3.9:rem max speed value
      tk#(n,16)=1:hide limb n,1:rem limb to fire tank
      tk#(n,19)=115:rem reload time
      tk#(n,20)=100:rem bullet counter
      tk#(n,21)=20:rem power of bullet
      tk#(n,33)=25:rem range collision (1/2 tank dimension)
      tk#(n,36)=-1.8:rem initial degree shot
      tk#(n,37)=125:tk#(n,49)=tk#(n,37):rem energy
      tk#(n,39)=1.65:rem k magnifier for bullet shot himpact
      tk#(n,40)=5000:rem k start sound engine
      tk#(n,41)=21:rem range collision height tank (1/2 tank height)
      tk#(n,42)=0.01:rem gravity
      tk#(n,43)=1:rem 1 can fire, 0 can't fire
      tk#(n,46)=600:rem time of turbo
      tk#(n,47)=3000:rem reload turbo time
      rem loading bullet (bullet is 100+n object)
      clone object n+100,65211
      scale object n+100,200,200,200
      set object specular n+100,0
      set object n+100,1,0,0,0,0,0,0
      hide object n+100:position object n+100,0,-5000,0
      rem make shadow (shadow is 200+n object)
      clone object n+200,65212
      scale object n+200,145,145,145
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      rem loading hitball (hitball is 300+n object)
      clone object n+300,65214
      set object specular n+300,0
      set object n+300,1,0,1,0,0,0,0
      ghost object on 300+n
      hit(n)=0
      hide object n+300:position object n+300,0,-5000,0
      endcase

      case 8
      clone object n,65200+t
      texture object n,100+c
      scale object n,105,101,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.7:rem steering value
      tk#(n,8)=3.1:rem max speed value
      tk#(n,16)=1:hide limb n,1:rem limb to fire tank
      tk#(n,19)=150:rem reload time
      tk#(n,20)=150:rem bullet counter
      tk#(n,21)=24:rem power of bullet
      tk#(n,33)=29:rem range collision (1/2 tank dimension)
      tk#(n,36)=-1:rem initial degree shot
      tk#(n,37)=140:tk#(n,49)=tk#(n,37):rem energy
      tk#(n,39)=1.75:rem k magnifier for bullet shot himpact
      tk#(n,40)=5500:rem k start sound engine
      tk#(n,41)=21:rem range collision height tank (1/2 tank height)
      tk#(n,42)=0.008:rem gravity
      tk#(n,43)=1:rem 1 can fire, 0 can't fire
      tk#(n,46)=2000:rem time of turbo
      tk#(n,47)=5000:rem reload turbo time
      rem loading bullet (bullet is 100+n object)
      clone object n+100,65211
      scale object n+100,210,210,210
      set object specular n+100,0
      set object n+100,1,0,0,0,0,0,0
      hide object n+100:position object n+100,0,-5000,0
      rem make shadow (shadow is 200+n object)
      clone object n+200,65212
      scale object n+200,155,155,155
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      rem loading hitball (hitball is 300+n object)
      clone object n+300,65214
      set object specular n+300,0
      set object n+300,1,0,1,0,0,0,0
      ghost object on 300+n
      hit(n)=0
      hide object n+300:position object n+300,0,-5000,0
      endcase

      case 10:rem cow(50 frames)
      tk#(n,2)=-1000
      clone object n,65224
      scale object n,220,220,220
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.5:rem steering value
      tk#(n,8)=0.25:rem max speed value
      tk#(n,16)=1:rem cow frame counter
      tk#(n,19)=0.4:rem anim speed
      tk#(n,20)=75:rem bullet counter
      tk#(n,32)=20:rem aim direction factor
      tk#(n,33)=17:rem range collision (1/2 tank dimension)
      tk#(n,37)=1:rem energy
      tk#(n,41)=13:rem range collision height tank (1/2 tank height)
      tk#(n,43)=0:rem 1 can fire, 0 can't fire
      rem make shadow (shadow is 200+n object)
      load object "tank/shadow.x",n+200
      scale object n+200,75,75,75
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      endcase

      case 11:rem camel(50 frames)
      tk#(n,2)=-1000
      clone object n,65225
      scale object n,220,220,220
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.4:rem steering value
      tk#(n,8)=0.22:rem max speed value
      tk#(n,16)=1:rem cow frame counter
      tk#(n,19)=0.37:rem anim speed
      tk#(n,20)=75:rem bullet counter
      tk#(n,32)=20:rem aim direction factor
      tk#(n,33)=17:rem range collision (1/2 tank dimension)
      tk#(n,37)=1.5:rem energy
      tk#(n,41)=14:rem range collision height tank (1/2 tank height)
      tk#(n,43)=0:rem 1 can fire, 0 can't fire
      rem make shadow (shadow is 200+n object)
      load object "tank/shadow.x",n+200
      scale object n+200,77,77,80
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      endcase

      case 12:rem frozed sheep(50 frames)
      tk#(n,2)=-1000
      clone object n,65226
      scale object n,225,230,225
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.4:rem steering value
      tk#(n,8)=0.22:rem max speed value
      tk#(n,16)=1:rem cow frame counter
      tk#(n,19)=0.37:rem anim speed
      tk#(n,20)=75:rem bullet counter
      tk#(n,32)=20:rem aim direction factor
      tk#(n,33)=17:rem range collision (1/2 tank dimension)
      tk#(n,37)=1.5:rem energy
      tk#(n,41)=14:rem range collision height tank (1/2 tank height)
      tk#(n,43)=0:rem 1 can fire, 0 can't fire
      rem make shadow (shadow is 200+n object)
      load object "tank/shadow.x",n+200
      scale object n+200,79,77,80
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      endcase

      case 13:rem moon alien(50 frames)
      tk#(n,2)=-1000
      clone object n,65227
      scale object n,225,225,225
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      rem setting for tank
      tk#(n,7)=0.2:rem steering value
      tk#(n,8)=0.20:rem max speed value
      tk#(n,16)=1:rem cow frame counter
      tk#(n,19)=0.37:rem anim speed
      tk#(n,20)=75:rem bullet counter
      tk#(n,32)=20:rem aim direction factor
      tk#(n,33)=12:rem range collision (1/2 tank dimension)
      tk#(n,37)=1.5:rem energy
      tk#(n,41)=12:rem range collision height tank (1/2 tank height)
      tk#(n,43)=0:rem 1 can fire, 0 can't fire
      rem make shadow (shadow is 200+n object)
      load object "tank/shadow.x",n+200
      scale object n+200,50,65,50
      rem setting no light and no mipmapping for cartoon style
      set object specular n+200,0:set object n+200,1,0,1,0,1,0,0
      set object texture n+200,0,0:ghost object on n+200,1
      endcase
   endselect

   rem speciality setting
   select c
      case 1:rem the slug
      tk#(n,7)=tk#(n,7)/1.05:rem turning
      tk#(n,8)=tk#(n,8)/1.05:rem speed
      tk#(n,21)=tk#(n,21)*1.05:rem firepower
      tk#(n,37)=tk#(n,37)*1.05:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 2:rem the braves
      tk#(n,7)=tk#(n,7)*1.05:rem turning
      tk#(n,8)=tk#(n,8)*1.05:rem speed
      tk#(n,21)=tk#(n,21)/1.05:rem firepower
      tk#(n,37)=tk#(n,37)*1:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 3:rem the smashers
      tk#(n,7)=tk#(n,7)/1.07:rem turning
      tk#(n,8)=tk#(n,8)/1.07:rem speed
      tk#(n,21)=tk#(n,21)*1.10:rem firepower
      tk#(n,37)=tk#(n,37)*1.10:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 4:rem the yanks
      tk#(n,7)=tk#(n,7)/1:rem turning
      tk#(n,8)=tk#(n,8)/1:rem speed
      tk#(n,21)=tk#(n,21)*1:rem firepower
      tk#(n,37)=tk#(n,37)*1:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 5:rem the Hooks
      tk#(n,7)=tk#(n,7)*1.1:rem turning
      tk#(n,8)=tk#(n,8)*1.1:rem speed
      tk#(n,21)=tk#(n,21)/1.15:rem firepower
      tk#(n,37)=tk#(n,37)*1.1:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 6:rem the boars
      tk#(n,7)=tk#(n,7)*1.1:rem turning
      tk#(n,8)=tk#(n,8)*1.1:rem speed
      tk#(n,21)=tk#(n,21)*1.135:rem firepower
      tk#(n,37)=tk#(n,37)/1.05:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 7:rem the bullets
      tk#(n,7)=tk#(n,7)*1.1:rem turning
      tk#(n,8)=tk#(n,8)*1.1:rem speed
      tk#(n,21)=tk#(n,21)*1.135:rem firepower
      tk#(n,37)=tk#(n,37)*1.105:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 8:rem the kisses
      tk#(n,7)=tk#(n,7)*1.12:rem turning
      tk#(n,8)=tk#(n,8)*1.12:rem speed
      tk#(n,21)=tk#(n,21)*1.25:rem firepower
      tk#(n,37)=tk#(n,37)*1.25:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 9:rem the skulls
      tk#(n,7)=tk#(n,7)*1.2:rem turning
      tk#(n,8)=tk#(n,8)*1.2:rem speed
      tk#(n,21)=tk#(n,21)*1.35:rem firepower
      tk#(n,37)=tk#(n,37)*1.35:tk#(n,49)=tk#(n,37):rem energy
      endcase
      case 10:rem the butchers, the Riddick's squad
      tk#(n,7)=tk#(n,7)*1.25:rem turning
      tk#(n,8)=tk#(n,8)*1.25:rem speed
      tk#(n,21)=tk#(n,21)*1.55:rem firepower
      tk#(n,37)=tk#(n,37)*1.75:tk#(n,49)=tk#(n,37):rem energy
      endcase
   endselect
endfunction

function makesortie(l,se,sg)
rem l is level of difficulty, se is squad primary enemy,sg is guest squad
rem player(10,n)n
rem 1 tipe tank
rem 3 ai tank
rem gam(7)=player squad
rem this function start to determinate the squad of the enemies
rem tankloader(n,t,c) where n is the object number, t tank tipe, c squad
rem casenemy(r,t) r difficulty, t case.
rem list of spec(n,d)
rem n,1=ai1 : n,2=ai2 : n,3=aim : n,4=firerate : n,5=energy decreaser
rem n,6=number of enemy : n,7=number of tanks of guest squad
rem main enemy squad
ne=spec(l,6)
for e=13 to 13+ne
   rem deciding ai on the reading of spec()
   tk#(e,30)=spec(l,1)
   if rnd(100)>65 then tk#(e,30)=spec(l,2)
   rem skill enemy
   tk#(e,26)=0:tk#(e,5)=180:rem initaial target=0:head at bottom of the map
   tk#(e,32)=spec(l,3)
   tk#(e,31)=spec(l,4)-rnd(4)
   rem tipe selection
   what=1+rnd(15):if what>15 then what=15
   tipe=casenemy(l,what)
   rem loading tank
   tankloader(e,tipe,se)
   rem energy decreaser
   tk#(e,37)=(tk#(e,37)*100)/spec(l,5):tk#(e,49)=tk#(e,37)
   rem positioning tank
   degx=4000/(2+ne):v=e-12:rem suddivide grid to make tanks aligned on their side
   tk#(e,1)=500+(degx*v)
   tk#(e,2)=-1000
   tk#(e,3)=5000
next e
rem guest enemy squad
ne=0
if spec(l,7)>0 then ne=1+rnd(spec(l,7)):if ne>4 then ne=4
if ne>0
ne=ne-1
for e=41 to 41+ne
   rem deciding ai on the reading of spec()
   tk#(e,30)=spec(l,1)
   rem skill enemy
   tk#(e,26)=0:tk#(e,5)=rnd(359):rem placed at random
   tk#(e,32)=spec(l,3)+3:rem more idiot than enemy
   tk#(e,31)=spec(l,4)
   rem tipe selection
   what=1+rnd(15):if what>15 then what=15
   tipe=casenemy(l,what)
   rem loading tank
   tankloader(e,tipe,sg)
   rem energy decreaser
   tk#(e,37)=(tk#(e,37)*100)/spec(l,5):tk#(e,49)=tk#(e,37)
   rem positioning tank
   degx=4000/(2+ne):v=e-40:rem suddivide grid to make tanks aligned on their side
   tk#(e,1)=500+(degx*v)
   tk#(e,2)=-1000
   tk#(e,3)=2200+rnd(600)
next e
endif
rem now for player squad
npa=0:rem number of player active=0
for np=1 to 12:if player(np,1)>0 then inc npa
next np
entry=0
for p=1 to 12
if player(p,1)>0
   if gam(1)=0 then gam(1)=p:rem if commander is not selected
   tk#(p,30)=player(p,3)
   inc entry
   rem skill enemy
   tk#(p,26)=0:tk#(p,5)=0:rem initaial target=0:head at top of the map
   tk#(p,32)=22-player(p,3)*1.4-rnd(1):rem aim factor
   tk#(p,31)=980-player(p,3)*1.4-rnd(15):rem fire factor
   rem loading tank
   tip=player(p,1):sp=gam(7)
   tankloader(p,tip,sp)
   rem positioning tank
   degx=4000/(1+npa)::rem suddivide grid to make tanks aligned on their side
   tk#(p,1)=500+(degx*entry)
   tk#(e,2)=-1000
   tk#(p,3)=100
endif
next p
rem make the first 5 powups (2 energy,2 bullet)
for p=1 to 2:rem makeing the first 2 energy
      o=50+p
      load object "object/pup1.x",o
      scale object o,100,100,100
      set object specular o,0
      set object o,1,0,1,0,0,0,0
      set object texture o,0,0
      powup(o):rem make powup
      tk#(o,4)=1550+rnd(200):rem first time ever powup on map
next p
   rem make repair pup
      load object "object/pup3.x",53
      scale object 53,100,100,100
      set object specular 53,0
      set object 53,1,0,1,0,0,0,0
      set object texture 53,0,0
      powup(53):rem make powup
      tk#(53,4)=4500+rnd(200):rem first time ever powup on map
for p=4 to 5:rem makeing the 2 superbullet energy
      o=50+p
      load object "object/pup2.x",o
      scale object o,100,100,100
      set object specular o,0
      set object o,1,0,1,0,0,0,0
      set object texture o,0,0
      powup(o):rem make powup
      tk#(o,4)=1550+rnd(200):rem first time ever powup on map
next p
endfunction

function track(n)
   rem n is the object to track
   rem calling reverse
   rv=joystick fire b()+keystate(157):if rv>1 then rv=1
   rem calling camera position
   tx#=newxvalue(tk#(n,1),tk#(n,5),-175+rv*375)
   tz#=newzvalue(tk#(n,3),tk#(n,5),-175+rv*375)
   rem camera on tree?
   xcm=tx#/100:zcm=tz#/100:htree=0
   obs=ter(0,xcm,zcm):if obs=1 then htree=40
   rem height of camera
   ty#=get ground height(1,tx#,tz#)+105+htree+tk#(n,2)/11
   rem inertial camera
   cam#(1)=cam#(1)+(tx#-cam#(1))/14
   cam#(2)=cam#(2)+(ty#-cam#(2))/16
   cam#(3)=cam#(3)+(tz#-cam#(3))/16
   position camera cam#(1),cam#(2),cam#(3)
   point camera tk#(n,1),tk#(n,2)+30,tk#(n,3)
endfunction

function slipcam()
   n=0:tg=gam(8):rem the function is the normal move tank, adapted to camera
   tgx#=tk#(tg,1)
   tgz#=tk#(tg,3)
   dx#=tk#(n,1)-tgx#:dz#=tk#(n,3)-tgz#
   r#=sqrt((dx#*dx#)+(dz#*dz#)):rem range tank on 2d plane
   rem heading
   position object 65000,tk#(n,1),0,tk#(n,3)
   point object 65000,tgx#,0,tgz#
   tk#(n,5)=wrapvalue(object angle y(65000))
   rem moving tank
   f#=6+r#/125
   tk#(n,1)=newxvalue(tk#(n,1),tk#(n,5),f#)
   tk#(n,3)=newzvalue(tk#(n,3),tk#(n,5),f#)
   tk#(n,2)=get ground height(1,tk#(n,1),tk#(n,3))
   rem limit map
   if tk#(n,1)<370 then tk#(n,1)=370
   if tk#(n,3)<370 then tk#(n,3)=370
   if tk#(n,1)>4630 then tk#(n,1)=4630
   if tk#(n,3)>4630 then tk#(n,3)=4630
   rem if range to control tank
   if r#<7.5 then gam(1)=gam(8):gam(8)=0
endfunction

function camintro()
   rem function for intro tank
   rem centering cam
   cam#(1)=2500:cam#(2)=1000:cam#(3)=2500
   msg=0
   rem make fake object 0 to track
   tgx#=500+rnd(4000):tgz#=500+rnd(4000)
   n=0:tk#(n,1)=500+rnd(4000):tk#(n,3)=500+rnd(4000)
   ga=0
   rem make start routine
   pnt:
   ga=ga+5:if ga>255 then ga=255
   set gamma ga,ga,ga
   dx#=tk#(n,1)-tgx#:dz#=tk#(n,3)-tgz#
   r#=sqrt((dx#*dx#)+(dz#*dz#)):rem range tank on 2d plane
   if r#<110 or rnd(100)>97 then tgx#=500+rnd(4000):tgz#=500+rnd(4000):rem change target if range is close
   rem heading point intro
   position object 65000,tk#(n,1),0,tk#(n,3)
   point object 65000,tgx#,0,tgz#
   ry#=wrapvalue(object angle y(65000))
   tan#=wrapvalue(tk#(n,5)-ry#):flag=1:ta=abs(tan#)
   if ta=>355 or ta<=5
      xj#=0
   else
      if ta>180 then flag=0-flag
      if tan#>0 then xj#=0-flag
      if tan#<0 then xj#=flag
   endif
   if xj#<>0
      tk#(n,9)=tk#(n,9)+(xj#*0.05)
      if abs(tk#(n,9))>0.7
         if tk#(n,9)<0 then tk#(n,9)=-0.7
         if tk#(n,9)>0 then tk#(n,9)=0.7
      endif
   endif
   if xj#=0 and abs(tk#(n,9))=>0.05 then tk#(n,9)=tk#(n,9)/1.15:if abs(tk#(n,9))<=0.06 then tk#(n,9)=0
   rem turning tank
   tk#(n,5)=wrapvalue(tk#(n,5)+tk#(n,9))
   rem bounce tank
   if rnd(1000)>997 and b#=0 then b#=0.001:ac#=10+rnd(30)
   if b#>0 then b#=b#+ac#:ac#=ac#-0.5:if b#<0 then b#=0
   rem moving tank
   f#=0.5+r#/500
   tk#(n,1)=newxvalue(tk#(n,1),tk#(n,5),f#)
   tk#(n,3)=newzvalue(tk#(n,3),tk#(n,5),f#)
   tk#(n,2)=get ground height(1,tk#(n,1),tk#(n,3))+b#/10
   rem limit map
   if tk#(n,1)<370 then tk#(n,1)=370
   if tk#(n,3)<370 then tk#(n,3)=370
   if tk#(n,1)>4630 then tk#(n,1)=4630
   if tk#(n,3)>4630 then tk#(n,3)=4630
   track(0)
   rem animate text
   ang#=wrapvalue(ang#+0.95)
   ang2#=wrapvalue(ang2#+1.35)
   msg=msg+1:if msg>510 then msg=510
   sprite 1,320,240,13
   set sprite 1,0,1
   offset sprite 1,189,15
   set sprite alpha 1,msg/2
   rotate sprite 1,cos(ang#)*12
   scale sprite 1,100+sin(ang2#)*25
   rem paste scenario image
   paste image 84+gam(25),10,10,1
   rem sync call
   sync
   rem go out if joystick fire or spacekey
   mv=abs(joystick x()/200)+abs(joystick y()/200)+rightkey()+leftkey()+upkey()+downkey()
   if mv>0 and ga=>255 then goto out
   goto pnt
   out:
   delete sprite 1
endfunction

function powup(o)
   rem o is the number of powup
   rem 51-52 energy
   rem 53 repair
   rem 54-55 bullet
   coord:
   x=500+rnd(4000)
   z=500+rnd(4000)
   xm=x/100:zm=z/100
   if ter(0,xm,zm)=1 then goto coord
   y#=get ground height(1,x,z)
   position object o,x,y#,z
   hide object o
   tk#(o,0)=0
   tk#(o,1)=x
   tk#(o,3)=z
   tk#(o,2)=y#
   tk#(o,5)=rnd(359)
   yrotate object o,tk#(o,5)
   tk#(o,4)=2500+rnd(2500):rem rnd apparition powup
   if o=53 then tk#(o,4)=tk#(o,4)+3500:rem rnd apparition powup
endfunction

function gameintro()
   rem function for intro game (like intro scenario)
   rem centering cam
   cam#(1)=2500:cam#(2)=1000:cam#(3)=2500
   msg=0
   rem create random terrain
   cls 0:sync
   load image "scr/title.bmp",60000,1
   load music "music/intro.mp3",1
   tr=1+rnd(599)/100
   maketerrain(tr)
   rem fake object to track
   make object plain 65000,1,1:hide object 65000
   rem play music intro
   play music 1:loop music 1:set music volume 1,95
   rem make fake object 0 to track
   tgx#=500+rnd(4000):tgz#=500+rnd(4000)
   n=0:tk#(n,1)=500+rnd(4000):tk#(n,3)=500+rnd(4000)
   ga=0
   rem make start routine
   pnt2:
   ga=ga+5:if ga>255 then ga=255
   set gamma ga,ga,ga
   dx#=tk#(n,1)-tgx#:dz#=tk#(n,3)-tgz#
   r#=sqrt((dx#*dx#)+(dz#*dz#)):rem range tank on 2d plane
   if r#<110 or rnd(100)>97 then tgx#=500+rnd(4000):tgz#=500+rnd(4000):rem change target if range is close
   rem heading point section
   position object 65000,tk#(n,1),0,tk#(n,3)
   point object 65000,tgx#,0,tgz#
   ry#=wrapvalue(object angle y(65000))
   tan#=wrapvalue(tk#(n,5)-ry#):flag=1:ta=abs(tan#)
   if ta=>355 or ta<=5
      xj#=0
   else
      if ta>180 then flag=0-flag
      if tan#>0 then xj#=0-flag
      if tan#<0 then xj#=flag
   endif
   if xj#<>0
      tk#(n,9)=tk#(n,9)+(xj#*0.05)
      if abs(tk#(n,9))>0.7
         if tk#(n,9)<0 then tk#(n,9)=-0.7
         if tk#(n,9)>0 then tk#(n,9)=0.7
      endif
   endif
   if xj#=0 and abs(tk#(n,9))=>0.05 then tk#(n,9)=tk#(n,9)/1.15:if abs(tk#(n,9))<=0.06 then tk#(n,9)=0
   rem turning tank
   tk#(n,5)=wrapvalue(tk#(n,5)+tk#(n,9))
   rem bounce tank
   if rnd(1000)>997 and b#=0 then b#=0.001:ac#=10+rnd(30)
   if b#>0 then b#=b#+ac#:ac#=ac#-0.5:if b#<0 then b#=0
   rem moving tank
   f#=0.5+r#/500
   tk#(n,1)=newxvalue(tk#(n,1),tk#(n,5),f#)
   tk#(n,3)=newzvalue(tk#(n,3),tk#(n,5),f#)
   tk#(n,2)=get ground height(1,tk#(n,1),tk#(n,3))+b#/10
   rem limit map
   if tk#(n,1)<370 then tk#(n,1)=370
   if tk#(n,3)<370 then tk#(n,3)=370
   if tk#(n,1)>4630 then tk#(n,1)=4630
   if tk#(n,3)>4630 then tk#(n,3)=4630
   track(0)
   rem animate text
   ang#=wrapvalue(ang#+0.55)
   ang2#=wrapvalue(ang2#+1.35)
   msg=msg+1:if msg>510 then msg=510
   sprite 1,320,240,60000:set sprite 1,0,1
   offset sprite 1,253,192
   set sprite alpha 1,msg/2
   rotate sprite 1,cos(ang#)*20
   scale sprite 1,75+sin(ang2#)*40
   sync
   rem go out if joystick fire or spacekey
   mv=spacekey()+joystick fire a()+mouseclick()
   if mv>0 and msg=>5 then goto out2
   goto pnt2
   out2:
   rem fading
   alph=msg/2:vad#=255/alph:rem fading sprite 1 value
   for t=255 to 1 step -3
   v=t/2.7:set music volume 1,v
   set sprite alpha 1,t/vad#
   set gamma t,t,t
   sleep 15
   next t
   delete sprite 1
   delete music 1
   delete image 60000
   delete object 65000
   rem resetting color 0 (1st attemp)
   sleep 15
   cls 0:sync:cls 0:sync
   ink 0,0:box 0,0,640,480
   sync
   randomize timer()
   rem clean data matrix
   for tre=1001 to 1100:rem deleting trees and clouds and sky
   if object exist(tre) then delete object tre
   next tre
   for co=45 to 50:rem deleting cows
   if object exist(co) then delete object co
   if object exist(co+200) then delete object co+200
   next co
   for t=1 to 75:for z=0 to 3:tree(t,z)=0:next z:next t:rem reset tree
   for ob=1 to 55:for v=0 to 52:tk#(ob,v)=0:next v:next ob:rem reset tank
   for g=2 to 13:gam(g)=0:next g:rem reset game
   for cl=1 to 10:for v=1 to 4:cl#(cl,v)=0:next v:next cl:rem reset cloud
   for x=0 to 50:for z=0 to 50
   ter(0,x,z)=0:ter(1,x,z)=0:ter(2,x,z)=0
   next z:next x:rem reset ground
endfunction

function repotanks()
   rem using clone of tanks() for fisrts placing tank
   rem start control tanks (1-50)
   for n=1 to 50
      if tk#(n,0)>0:rem if tank active
      rem ************************************************************************
      rem *                           inclination engine                         *
      rem ************************************************************************
      rem finding 2 point for inclination (xax,zax for up dpwm, xaz,zaz for roll)
      rem this is for pitch (using atan for angle of inclination)
      hg#=get ground height(1,tk#(n,1),tk#(n,3))
      xax#=newxvalue(tk#(n,1),tk#(n,5),10)
      zax#=newzvalue(tk#(n,3),tk#(n,5),10)
      hx#=get ground height(1,xax#,zax#)-hg#
      ax#=atan(hx#/10.0)
      tk#(n,4)=tk#(n,4)+(ax#-tk#(n,4))/20.0:rem inertial angle
      rem this is for roll (using atan for angle of inclination)
      xaz#=newxvalue(tk#(n,1),tk#(n,5)-90,10)
      zaz#=newzvalue(tk#(n,3),tk#(n,5)-90,10)
      hz#=get ground height(1,xaz#,zaz#)-hg#
      az#=atan(hz#/10.0)
      tk#(n,6)=tk#(n,6)+(az#-tk#(n,6))/20.0:rem inertial angle
      rem ************************************************************************
      rem *                           moving tank on the map                     *
      rem ************************************************************************
      rem moving tank
      rem limit map position
      if tk#(n,1)<370 then tk#(n,1)=370:tk#(n,10)=tk#(n,10)/1.015:tk#(n,27)=0:tk#(n,29)=0:tk#(n,26)=51
      if tk#(n,3)<370 then tk#(n,3)=370:tk#(n,10)=tk#(n,10)/1.015:tk#(n,27)=0:tk#(n,29)=0:tk#(n,26)=51
      if tk#(n,1)>4630 then tk#(n,1)=4630:tk#(n,10)=tk#(n,10)/1.015:tk#(n,27)=0:tk#(n,29)=0:tk#(n,26)=51
      if tk#(n,3)>4630 then tk#(n,3)=4630:tk#(n,10)=tk#(n,10)/1.015:tk#(n,27)=0:tk#(n,29)=0:tk#(n,26)=51

      rem ************************************************************************
      rem *          inclination setting, bounce effect and shadow               *
      rem ************************************************************************
      rem height of map at tank position
      hg#=get ground height(1,tk#(n,1),tk#(n,3)):rem height of ground
      rem height control of tank and gravity
      tk#(n,22)=tk#(n,22)-0.115:if tk#(n,22)<-10 then tk#(n,22)=-10
      tk#(n,2)=tk#(n,2)+tk#(n,22)
      if tk#(n,2)<hg# then tk#(n,2)=hg#:tk#(n,23)=1:rem is on ground
      rem now setting to 0 the angle of rotation and turn object
      rotate object n,0,0,0
      rem controls flip dead cows
      rem turning object
      turn object right n,tk#(n,5)
      pitch object up n,(tk#(n,4)+sin(tk#(n,12))*2)
      roll object right n,flipcow#+tk#(n,6)+tk#(n,9)*3
      rem then positioning object
      position object n,tk#(n,1),slop#+tk#(n,2)+3.3,tk#(n,3)
      rem placing shadow
      rotate object n+200,0,0,0
      turn object right n+200,tk#(n,5)
      pitch object up n+200,tk#(n,4)
      roll object right 200+n,tk#(n,6)
      rem then positioning shadow object
      position object 200+n,tk#(n,1),hg#+3.5-slop#*10,tk#(n,3)
      rem barrier on/off flag and super bullet
      hide limb 200+n,1
      hide limb 200+n,2
      rem reset sprite
      endif
   next n
   rem ************************** clouds routine *********************************
   for ob=1076 to 1076+gam(9)
      o=ob-1075:rem rotate clound on center map
      cl#(o,2)=wrapvalue(cl#(o,2)+cl#(o,4))
      xc#=2500+cl#(o,1)*cos(cl#(o,2))
      zc#=2500+cl#(o,1)*sin(cl#(o,2))
      hc#=get ground height(1,xc#,zc#)+450+cl#(o,2)/50
      rem limit map
      if xc#<470 then xc#=470
      if xc#>4530 then xc#=4530
      if zc#<470 then zc#=470
      if zc#>4530 then zc#=4530
      rem positioning cloud
      position object ob,xc#,hc#,zc#
      yrotate object ob,wrapvalue(cl#(o,2)+90)
   next ob
endfunction

function entra()
   rem tile on entering program
   load image "erm/logo.png",1,1
   load image "erm/data1.bmp",2,1
   load image "erm/data2.bmp",3,1
   load sound "erm/logo.wav",1
   et=0
   repeat
      cls 0
      inc et
      yu=300-et:if yu<0 then yu=0
      dx=rnd(yu)/2-(yu/4):dy=rnd(yu)/2-(yu/4)
      ddx=rnd(yu)/10-(yu/20):ddy=rnd(yu)/10-(yu/20)
      paste image 1,120+dx,45+dy
      paste image 2,2+ddx,400+ddy
      if et=100 then play sound 1
      if et>350 then paste image 3,258,360
      sync
      ff=0
      ff=spacekey()+joystick fire a()+mouseclick()
   until et>350 and ff=1
   for t=255 to 1 step -3:set gamma t,t,t:sleep 15:next t
   rem cleaning up screen
   sleep 200
   cls 0:sync:cls 0:sync
   ink 0,0:box 0,0,640,480
   sync
   set gamma 256,256,256
   delete image 1
   delete image 2
   delete image 3
   sleep 15
   delete sound 1
endfunction

function menu()

   rem lock/unlock squads
   gam(1)=0:esc=0:free=2
   if gam(14)>12 then free=3
   if gam(14)>15 then free=4
   if gam(14)>18 then free=5
   if gam(14)>23 then free=6
   if gam(14)>27 then free=7
   if gam(14)>35 then free=8
   if gam(14)>43 then free=9
   frep=free:if sav(1)=1 then frep=10:rem if game is completed, then unlock the 10th squad

   for t=1 to 8:rem make tanks
      tankloadermenu(t+10000,t,1)
      hide object t+10000
      tankloadermenu(t+10010,t,1)
      hide object t+10010
   next t

   rem loading menu for game
   load image "menu/up.bmp",10001,1
   load image "menu/mouse.bmp",10002,1
   load image "menu/slevel.bmp",10003,1
   load image "menu/ssquad.bmp",10004,1
   load image "menu/ar1.bmp",10005,1
   load image "menu/ar2.bmp",10006,1
   load image "menu/boxsel.bmp",10007,1
   load image "menu/box.bmp",10008,1
   load image "menu/boxs.bmp",10009,1

   rem loading name tanks
   for t=1 to 8
   load image "menu/no"+str$(t)+".bmp",11000+t,1
   next t
   rem loading images for tank
   rem for i=1 to 4:load image "tank/t"+str$(i)+".bmp",10100+i,1:next i
   rem load digit
   for t=10 to 19
   load image "menu/dg"+str$(t-10)+".bmp",10000+t,1
   next t
   rem load squad
   for t=21 to 30
   load image "menu/sq"+str$(t-20)+".bmp",10000+t,1
   next t
   rem load buttons
   for t=31 to 50
   load image "menu/p"+str$(t-30)+".bmp",10000+t,1
   next t
   rem 1-next,2-back,3-battle,4-buytank (100x30)
   rem 5-in box,6-shop,7-camera outbounds, 8 select tank, 9 sell tank
   rem 10-buy, 11-cr, 12-aibar, 13 grensc ai,14 green ai, 15 black ai
   rem 16-ai select, 17-make commander,18-pl mark,19 make your squad
   rem 20-locked

   rem intro sprites
   sprite 1,800,800,10001:offset sprite 1,256,50:sprite 2,500,500,10002
   rem centering cam
   cam#(1)=2500:cam#(2)=1000:cam#(3)=2500
   rem create random terrain
   cls 0:sync
   ms=1+rnd(199)/100:load music "menu/menu"+str$(ms)+".mid",1
   tr=1+rnd(599)/100:maketerrain(tr):repotanks()
   rem play music intro
   play music 1:loop music 1:set music volume 1,95
   rem make fake object 0 to track
   tgx#=500+rnd(4000):tgz#=500+rnd(4000)
   n=0:tk#(n,1)=500+rnd(4000):tk#(n,3)=500+rnd(4000)
   mensel=1:rem start with level/squad

   rem fading to screen view
   cls 0:ink 0,0:box 0,0,640,480:sleep 15:sync
   cls 0:ink 0,0:box 0,0,640,480:sleep 15:sync
   ga=0

   repeat
   ga=ga+5:if ga>255 then ga=255
   set gamma ga,ga,ga
   rem camera traxk procedure
   set current camera 0
   dx#=tk#(n,1)-tgx#:dz#=tk#(n,3)-tgz#
   r#=sqrt((dx#*dx#)+(dz#*dz#)):rem range tank on 2d plane
   if r#<110 or rnd(100)>97 then tgx#=500+rnd(4000):tgz#=500+rnd(4000):rem change target if range is close
   rem heading point section
   position object 65000,tk#(n,1),0,tk#(n,3)
   point object 65000,tgx#,0,tgz#
   ry#=wrapvalue(object angle y(65000))
   tan#=wrapvalue(tk#(n,5)-ry#):flag=1:ta=abs(tan#)
   if ta=>355 or ta<=5
      xj#=0
   else
      if ta>180 then flag=0-flag
      if tan#>0 then xj#=0-flag
      if tan#<0 then xj#=flag
   endif
   if xj#<>0
      tk#(n,9)=tk#(n,9)+(xj#*0.01)
      if abs(tk#(n,9))>0.3
         if tk#(n,9)<0 then tk#(n,9)=-0.3
         if tk#(n,9)>0 then tk#(n,9)=0.3
      endif
   endif
   if xj#=0 and abs(tk#(n,9))=>0.05 then tk#(n,9)=tk#(n,9)/1.15:if abs(tk#(n,9))<=0.06 then tk#(n,9)=0
   rem turning tank
   tk#(n,5)=wrapvalue(tk#(n,5)+tk#(n,9))
   rem moving tank
   f#=0.1+r#/1500
   tk#(n,1)=newxvalue(tk#(n,1),tk#(n,5),f#)
   tk#(n,3)=newzvalue(tk#(n,3),tk#(n,5),f#)
   tk#(n,2)=get ground height(1,tk#(n,1),tk#(n,3))
   rem limit map
   if tk#(n,1)<370 then tk#(n,1)=370
   if tk#(n,3)<370 then tk#(n,3)=370
   if tk#(n,1)>4630 then tk#(n,1)=4630
   if tk#(n,3)>4630 then tk#(n,3)=4630
   track(0)

   rem menu for all
   ang#=wrapvalue(ang#+0.15):rem title rotating effect
   ang2#=wrapvalue(ang2#+0.2):rem title zoom/unzoom
   rem positioning images
   sprite 1,320,95,10001
   scale sprite 1,70+45*sin(ang2#)
   rotate sprite 1,10*cos(ang#)
   rem mouse pointer
   xm=mousex():ym=mousey()
   sprite 2,xm,ym,10002

   if mensel=1
      rem menu 1st step> level and squad
      paste image 10003,0,200
      paste image 10004,0,250
      rem level number placed
      dc=gam(15)/10:uni=gam(15)-dc*10
      paste image 10010+dc,375,200
      paste image 10010+uni,385,200
      rem place arrow
      paste image 10005,190,200:paste image 10005,190,250
      paste image 10006,430,200:paste image 10006,430,250
      rem place squad info
      paste image 10020+gam(18),169,300
      rem place button next
      paste image 10031,270,440
      rem sensitive for mouse
      if mouseclick()=0 then mousehold=0
      if mouseclick()=1 and mousehold=0
         som=0
         mousehold=1
         inbx(xm,ym,190,200,210,220)
         if gam(17)=1 then gam(15)=gam(15)-1:som=1:if gam(15)<1 then gam(15)=1:som=2
         inbx(xm,ym,430,200,450,220)
         if gam(17)=1 then gam(15)=gam(15)+1:som=1:if gam(15)>gam(14) then gam(15)=gam(14):som=2
         inbx(xm,ym,190,250,210,270)
         if gam(17)=1 then gam(18)=gam(18)-1:som=1:if gam(18)<1 then gam(18)=10
         inbx(xm,ym,430,250,450,270)
         if gam(17)=1 then gam(18)=gam(18)+1:som=1:if gam(18)>10 then gam(18)=1
         inbx(xm,ym,270,440,370,470)
         if gam(17)=1
            som=2
            if frep=>gam(18) then mensel=2:som=1:rem next
         endif
      endif
      cord=500:if frep<gam(18) then cord=301
      sprite 2000,170,cord,10050:set sprite alpha 2000,125
      if som=1 then play sound 29:som=0
      if som=2 then play sound 18:som=0
   endif

   if mensel=2:rem preparing tank
      delete sprite 2000
      for t=10001 to 10008
      texture object t,100+gam(18)
      position object t,45000,0,45000
      set object specular t,0:set object t,1,0,1,0,0,0,0:set object texture t,0,0
      hide object t
      next t
      for t=10011 to 10018
      texture object t,100+gam(18)
      position object t,45000,0,-45000
      set object specular t,0:set object t,1,0,1,0,0,0,0:set object texture t,0,0
      hide object t
      next t
      make camera 2
      set camera view 2,30,300,210,420
      color backdrop 2,rgb(0,0,0)
      make camera 3
      set camera view 3,430,300,610,420
      color backdrop 3,rgb(0,0,0)
      mensel=3
      stt=1:boxsel=1
      minai=1+spec(gam(15),1)/2.5
      maxai=spec(gam(15),2)
      crmax=lev(gam(15),0):crused=0
   endif

   if mensel=3:rem tank select routine
      rem menu 2st step> box tank and lev ab
      set current camera 2
      tur#=wrapvalue(tur#+0.4)
      for t=10001 to 10008:hide object t:next t
      for t=10011 to 10018:hide object t:next t

      rem this show tank selected
      xc2#=46*cos(tur#)
      zc2#=47*sin(tur#)
      yc2#=4*sin(tur#)
      position camera 2,45000+xc2#,60+yc2#,45000-zc2#
      point camera 2,45000,10,45000
      show object 10000+stt
      paste image 10037,30,300,1
      paste image 10036,32,302,1:paste image 11000+stt,98,302,1
      rem cost in cr
      dc=cost(stt)/10:uni=cost(stt)-dc*10
      paste image 10010+dc,185,300,1
      paste image 10010+uni,195,300,1
      paste image 10041,165,302,1:rem cr vox
      paste image 10038,32,398

      rem this show tank in box
      set current camera 3
      position camera 3,45000+xc2#,60+yc2#,-45000+zc2#
      point camera 3,45000,10,-45000
      rem ai bar
      paste image 10042,430,275
      if player(boxsel,1)>0
         show object 10010+player(boxsel,1)
         paste image 11000+player(boxsel,1),498,302,1
         paste image 10041,565,302,1:rem cr vox
         rem cost in cr
         dc=cost(player(boxsel,1))/10:uni=cost(player(boxsel,1))-dc*10
         paste image 10010+dc,585,300,1
         paste image 10010+uni,595,300,1
      for t=1 to player(boxsel,3)
         im=44
         if t<=minai then im=43
         paste image 10000+im,453+(t-1)*13,279,1
      next t
      if player(boxsel,3)<maxai
         for t=player(boxsel,3)+1 to maxai
         paste image 10045,453+(t-1)*13,279,1
         next t
      endif
      endif
      paste image 10037,430,300,1
      paste image 10035,432,302,1
      paste image 10039,432,398
      paste image 10046,430,260
      paste image 10047,430,421

      for b=1 to 12:rem box draw
      im=8:if boxsel=b then im=9
      paste image 10000+im,5+(b-1)*53,222
      if player(b,1)>0 then paste image 232+player(b,1)+(gam(18)-1)*10,6+(b-1)*53,223,1
      if gam(1)=b then paste image 10048,16+(b-1)*53,223,1
      next b
      paste image 10049,220,165,1
      paste image 10007,0,200:rem select box
      rem box number placed
      dc=boxsel/10:uni=boxsel-dc*10
      paste image 10010+dc,337,200
      paste image 10010+uni,347,200
      rem enemy tanks show
      va=spec(gam(15),6)+1
      dc=va/10:uni=va-dc*10
      paste image 10010+dc,605,200,1
      paste image 10010+uni,615,200,1
      rem place arrow
      paste image 10005,190,200
      paste image 10006,430,200
      rem back icon/battle icon/buy
      paste image 10032,70,435
      paste image 10040,70,259
      paste image 10033,470,435
      rem place calculation credit
      cet=crmax/100:dect=crmax-cet*100:de=dect/10:uni=dect-de*10
      paste image 10010+cet,95,200
      paste image 10010+de,105,200
      paste image 10010+uni,115,200
      cdisp=crmax-crused
      cet=cdisp/100:dect=cdisp-cet*100:de=dect/10:uni=dect-de*10
      paste image 10010+cet,55,200
      paste image 10010+de,65,200
      paste image 10010+uni,75,200

      rem mouse controls
      if mouseclick()=0 then mousehold=0
      if mouseclick()=1 and mousehold=0
         mousehold=1
         som=0
         rem box selection
         inbx(xm,ym,190,200,210,220)
         if gam(17)=1 then dec boxsel:som=1:if boxsel<1 then boxsel=1:som=2
         inbx(xm,ym,430,200,450,220)
         if gam(17)=1 then inc boxsel:som=1:if boxsel>12 then boxsel=12:som=2

         rem intuition box selection
         if ym>222 and ym<247 then boxsel=1+xm/54:som=1

         rem tank selection
         inbx(xm,ym,32,398,52,418)
         if gam(17)=1 then dec stt:som=1:if stt<1 then stt=1:som=2
         inbx(xm,ym,187,398,207,418)
         if gam(17)=1 then inc stt:som=1:if stt>8 then stt=8:som=2

         rem buy
         inbx(xm,ym,70,259,170,289)
         if gam(17)=1
            som=2
            if player(boxsel,1)=0
            eval=crused+cost(stt)
            if eval<=crmax:rem credit control
               som=1:rem sound click
               player(boxsel,1)=stt:player(boxsel,3)=minai
               crused=crused+cost(stt)
            endif
            endif
         endif

         rem buy intuiton on tank
         inbx(xm,ym,30,300,210,395)
         if gam(17)=1
            som=2
            if player(boxsel,1)=0
            eval=crused+cost(stt)
            if eval<=crmax:rem credit control
               som=1:rem sound click
               player(boxsel,1)=stt:player(boxsel,3)=minai
               crused=crused+cost(stt)
            endif
            endif
         endif

         rem ai decrase
         inbx(xm,ym,430,275,450,295)
         if gam(17)=1
            som=2
            if player(boxsel,1)>0 and player(boxsel,3)>minai
            player(boxsel,3)=player(boxsel,3)-1
            crused=crused-2
            som=1
            endif
         endif

         rem ai increase
         inbx(xm,ym,590,275,610,295)
         if gam(17)=1
            som=2
            if player(boxsel,1)>0 and player(boxsel,3)<maxai
            eval=crused+2
            if eval<=crmax:rem credit control
               player(boxsel,3)=player(boxsel,3)+1
               crused=crused+2
               som=1:rem sound click
            endif
         endif
         endif

         rem sell
         inbx(xm,ym,488,400,543,413)
         if gam(17)=1
            som=2
            if player(boxsel,1)>0
            crused=crused-cost(player(boxsel,1))
            crused=crused-(player(boxsel,3)-minai)*2
            player(boxsel,1)=0
            player(bosxel,3)=0
            if gam(1)=boxsel then gam(1)=0
            som=1
            endif
         endif

         rem back
         inbx(xm,ym,70,435,170,465)
         if gam(17)=1
            mensel=1
            delete camera 2
            delete camera 3
            for t=1 to 12:player(t,1)=0:player(t,3)=0:next t
            som=1
         endif

         rem make commander
         inbx(xm,ym,430,421,610,434)
         if gam(17)=1
         som=2
         if player(boxsel,1)>0 then gam(1)=boxsel:som=1
         endif

         rem go battle
         inbx(xm,ym,470,435,570,465)
         if gam(17)=1
         som=2
         if crused>0 then esc=1:som=1
         endif

      endif
      if som=1 then play sound 29:som=0
      if som=2 then play sound 18:som=0
      endif
   sync
   until esc=1

   rem fading
   for t=255 to 4 step -3
   v=t/2.7:set music volume 1,v
   set sprite alpha 1,t
   set gamma t,t,t
   sleep 15
   next t
   set gamma 1,1,1
   delete sprite 1
   delete sprite 2
   delete music 1
   rem resetting color 0 (1st attemp)
   sleep 300
   cls 0:sync:cls 0:sync
   ink 0,0:box 0,0,640,480
   sync
   rem clean data

   rem clean data matrix
   for tre=1001 to 1100:rem deleting trees and clouds and sky
   if object exist(tre) then delete object tre
   next tre
   for co=45 to 50:rem deleting cows
   if object exist(co) then delete object co
   if object exist(co+200) then delete object co+200
   next co
   for t=1 to 75:for z=0 to 3:tree(t,z)=0:next z:next t:rem reset tree
   for ob=1 to 55:for v=0 to 52:tk#(ob,v)=0:next v:next ob:rem reset tank
   for g=2 to 13:gam(g)=0:next g:rem reset game
   for cl=1 to 10:for v=1 to 4:cl#(cl,v)=0:next v:next cl:rem reset cloud
   for x=0 to 50:for z=0 to 50
   ter(0,x,z)=0:ter(1,x,z)=0:ter(2,x,z)=0
   next z:next x:rem reset ground
   rem reset menu images
   for im=10000 to 12000
   if image exist(im) then delete image im
   if object exist(im) then delete object im
   next im
   rem setting oppo and guest
   oppn=((free-1)*100)+99
   repeat:rem oppo squad (depending on free unlock value)
      gam(19)=1+rnd(oppn)/100
   until gam(19)<>gam(18)
   repeat:rem guest all squad plays
      gam(20)=1+rnd(899)/100
   until gam(20)<>gam(19) and gam(20)<>gam(18)
   delete camera 2
   delete camera 3
   set current camera 0
endfunction

function inbx(xm,ym,x1,y1,x2,y2)
   rem function inbox for menu
   gam(17)=0
   if xm>x1 and xm<x2 and ym>y1 and ym<y2 then gam(17)=1
endfunction

function tankloadermenu(n,t,c)
   rem n is object number(1-50) ,t is the tipe of tank ,c is colour
   select t
      case 1
      clone object n,65200+t
      scale object n,100,110,100
      hide limb n,1
      texture object n,100+c
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 2
      clone object n,65200+t
      scale object n,102,105,100
      texture object n,100+c
      hide limb n,3
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 3
      clone object n,65200+t
      scale object n,102,105,100
      hide limb n,4
      texture object n,100+c
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 4
      clone object n,65200+t
      texture object n,100+c
      hide limb n,3
      scale object n,100,98,100
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 5
      clone object n,65200+t
      hide limb n,1
      texture object n,100+c
      scale object n,100,95,100
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 6
      clone object n,65200+t
      hide limb n,3
      texture object n,100+c
      scale object n,100,99,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 7
      clone object n,65200+t
      hide limb n,1
      texture object n,100+c
      scale object n,100,101,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase

      case 8
      clone object n,65200+t
      hide limb n,1
      texture object n,100+c
      scale object n,105,101,101
      rem setting no light and no mipmapping for cartoon style
      set object specular n,0:set object n,1,0,1,0,0,0,0:set object texture n,0,0
      endcase
   endselect
endfunction

function camending()
   rem function for intro tank
   msg=0:set sound volume 1,0:set sound volume 12,0
   rem make fake object 0 to track = last palyer view
   n=0:tk#(n,1)=tk#(gam(1),1):tk#(n,3)=tk#(gam(1),3)
   gam(1)=0:gam(8)=-1:rem reset player(can't move anymore)

   rem make first target
   tgx#=500+rnd(4000):tgz#=500+rnd(4000)

   pnt3:
   dx#=tk#(n,1)-tgx#:dz#=tk#(n,3)-tgz#
   r#=sqrt((dx#*dx#)+(dz#*dz#)):rem range tank on 2d plane
   if r#<110 or rnd(100)>97 then tgx#=500+rnd(4000):tgz#=500+rnd(4000):rem change target if range is close
   rem heading point intro
   position object 65000,tk#(n,1),0,tk#(n,3)
   point object 65000,tgx#,0,tgz#
   ry#=wrapvalue(object angle y(65000))
   tan#=wrapvalue(tk#(n,5)-ry#):flag=1:ta=abs(tan#)
   if ta=>355 or ta<=5
      xj#=0
   else
      if ta>180 then flag=0-flag
      if tan#>0 then xj#=0-flag
      if tan#<0 then xj#=flag
   endif
   if xj#<>0
      tk#(n,9)=tk#(n,9)+(xj#*0.05)
      if abs(tk#(n,9))>0.7
         if tk#(n,9)<0 then tk#(n,9)=-0.7
         if tk#(n,9)>0 then tk#(n,9)=0.7
      endif
   endif
   if xj#=0 and abs(tk#(n,9))=>0.05 then tk#(n,9)=tk#(n,9)/1.15:if abs(tk#(n,9))<=0.06 then tk#(n,9)=0
   rem turning tank
   tk#(n,5)=wrapvalue(tk#(n,5)+tk#(n,9))
   rem bounce tank
   if rnd(1000)>997 and b#=0 then b#=0.001:ac#=10+rnd(30)
   if b#>0 then b#=b#+ac#:ac#=ac#-0.5:if b#<0 then b#=0
   rem moving tank
   f#=0.5+r#/500
   tk#(n,1)=newxvalue(tk#(n,1),tk#(n,5),f#)
   tk#(n,3)=newzvalue(tk#(n,3),tk#(n,5),f#)
   tk#(n,2)=get ground height(1,tk#(n,1),tk#(n,3))+b#/10
   rem limit map
   if tk#(n,1)<370 then tk#(n,1)=370
   if tk#(n,3)<370 then tk#(n,3)=370
   if tk#(n,1)>4630 then tk#(n,1)=4630
   if tk#(n,3)>4630 then tk#(n,3)=4630
   track(0)
   rem animate text
   ang#=wrapvalue(ang#+0.95)
   ang2#=wrapvalue(ang2#+1.35)
   msg=msg+2:if msg>510 then msg=510
   rem calc image for victory/defeat
   im=2001:if gam(22)=0 then im=2002
   rem managing image
   sprite 151,320,190,im
   set sprite 151,0,1
   offset sprite 151,165,35
   set sprite alpha 151,msg/2
   rotate sprite 151,cos(ang#)*12
   scale sprite 151,100+sin(ang2#)*25
   rem click mouse to continue
   xof=10*cos(ang#)
   yof=10*sin(ang#)
   if msg>395 then paste image 2003,200+xof,380-yof,1

   rem calling tank functions
   tanks()
   sync
   rem go out if mousekey()
   mv=0:mv=mouseclick()
   if mv>0 and msg=>400 then goto out3
   goto pnt3
   out3:

   rem fading out
   alph=msg/2:vad#=255/alph:rem fading sprite 13 value
   rem music fadin
   vo=music volume(1)
   musc=1
   if vo=0 then musc=0
   if vo=1 then vol#=255/vo:rem fading music
   rem eliminate contourn sprite
   for s=1 to 150:if sprite exist(s) then delete sprite s
   next s

   rem fading
   for t=255 to 4 step -3
   if musc=1 then set music volume 1,t/vol#
   set sprite alpha 151,t/vad#
   set gamma t,t,t
   sleep 15
   next t
   set gamma 1,1,1
   delete sprite 151
   delete music 1
   rem resetting color 0 (1st attemp)
   sleep 15
   cls 0:sync:cls 0:sync
   ink 0,0:box 0,0,640,480
   sync
   rem reset player
   for p=1 to 12:player(p,1)=0:player(p,3)=0:next p
endfunction

